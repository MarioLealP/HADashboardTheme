FROM jenkins/jenkins:lts

USER root

# Install Node.js 20 LTS and required tools
RUN apt-get update && \
    apt-get install -y curl git rsync && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER jenkins
