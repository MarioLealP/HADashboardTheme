pipeline {
    agent any

    environment {
        REGISTRY = 'localhost:5000'
        IMAGE_NAME = 'endfield-dashboard'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('endfield-dashboard') {
                    sh """
                        docker build \
                            -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${REGISTRY}/${IMAGE_NAME}:${env.BRANCH_NAME ?: 'latest'} \
                            .
                    """
                }
            }
        }

        stage('Push to Artifact Registry') {
            steps {
                dir('endfield-dashboard') {
                    sh """
                        docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${REGISTRY}/${IMAGE_NAME}:${env.BRANCH_NAME ?: 'latest'}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Image ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} (and branch tag: ${env.BRANCH_NAME ?: 'latest'}) pushed! Watchtower will auto-update production."
        }
        failure {
            echo 'Pipeline failed. Check build logs.'
        }
    }
}
